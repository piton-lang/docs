// The pages of the documentation site that are generated from the Piton
// specification tethered into tethers/piton. Every `page` exported here is one
// page; plugins/spec-pages.mjs renders them, and src/content.config.ts adds
// them to Starlight's docs collection.
//
// The sidebar section a page appears in follows from the first segment of its
// slug; see src/config/sections.mjs.

from ./pages/belay export *
from ./pages/language export *
from ./pages/thesis export *
from ./pages/tooling export *
