{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "docs",
	"compatibility_date": "2026-09-08",
	// This is a fully static Starlight site: `astro build` writes prerendered
	// HTML to ./dist and there is no server code. Declaring `assets` with no
	// `main` deploys an assets-only Worker, which is what the `npx wrangler
	// deploy` command configured for this project expects.
	//
	// Do NOT add `pages_build_output_dir` here. It reclassifies the config as a
	// Cloudflare Pages project, and `wrangler deploy` then fails with "Missing
	// entry-point to Worker script or to assets directory". Pages is a
	// different product with a different deploy command, not a setting.
	//
	// This file also stops `wrangler deploy` from running its auto-config,
	// which otherwise runs `astro add cloudflare` and switches the build to an
	// SSR/worker target. That target breaks: Starlight's Markdown processor
	// (satteri) resolves through its `browser` export, which re-exports the
	// optional `@bruits/satteri-wasm32-wasi` package that npm does not install
	// on linux-x64, and rolldown fails to resolve it.
	"assets": {
		"directory": "./dist",
		// Serve Starlight's prerendered 404.html for unknown paths.
		"not_found_handling": "404-page"
	}
}
