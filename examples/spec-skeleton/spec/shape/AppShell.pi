use @piton/belay

from /concept/App import App
from /lib/CurrentStack import Current Stack

export instruction AppShell:
    description: The application shell and the stack it is built on.

    prompt:
        Build the application described in @{App}.

    stack:
        Build it with ${Stack.name} on ${Stack.language}. The entry point is
        ${Stack.entryPoint}. Full stack definition: @{Stack}.
