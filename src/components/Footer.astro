---
/**
 * Starlight Footer override.
 *
 * Keeps everything Starlight puts here (edit link, last updated, pagination)
 * and adds a contents-style site index, the wordmark, and a copyright line.
 *
 * The index is built from `starlightRoute.sidebar`, so it is the same tree as
 * the sidebar and cannot drift from it — adding a page or a group updates the
 * footer with no edit here.
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';

const route = Astro.locals.starlightRoute;
const sidebar = route.sidebar;

/*
 * The site index and the wordmark are a landing-page footer. Documentation
 * pages already carry the sidebar and the prev/next block, so they keep the
 * copyright alone.
 */
const isLanding = route.entry.data.template === 'splash';

/** Flatten a group's entries to plain links, one level deep. */
const linksOf = (entry: any): { label: string; href: string }[] => {
	if (!entry) return [];
	if (entry.type === 'link') return [{ label: entry.label, href: entry.href }];
	return (entry.entries ?? []).flatMap(linksOf);
};

/*
 * One column per smallest group. The sidebar's top level is now sections, and
 * a section that is wholly divided into groups (Introduction) contributes
 * those groups rather than one long column of everything beneath it. A section
 * that also holds loose pages stays a single column, so nothing is dropped.
 */
const columnsOf = (entry: any): { label: string; links: ReturnType<typeof linksOf> }[] => {
	const children = entry.entries ?? [];
	return children.length > 0 && children.every((child: any) => child.type === 'group')
		? children.flatMap(columnsOf)
		: [{ label: entry.label, links: linksOf(entry) }];
};

/*
 * A column shows at most this many links; the rest are behind a trigger that
 * floats the whole group over the index. Five keeps every column the same
 * height whatever the section holds, so the row of columns stays a row.
 */
const COLUMN_LIMIT = 5;

const groups = sidebar
	.filter((entry: any) => entry.type === 'group')
	.flatMap(columnsOf)
	.map((group) => ({
		...group,
		shown: group.links.slice(0, COLUMN_LIMIT),
		hidden: group.links.slice(COLUMN_LIMIT),
	}));

const year = new Date().getFullYear();
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	<div class:list={['pi-footer', { 'pi-footer--minimal': !isLanding }]}>
		{isLanding && (
		<nav class="pi-footer__index" aria-label="Site index">
			{
				groups.map((group: any) => (
					<div class="pi-footer__group">
						<h2>{group.label}</h2>
						<ul>
							{group.shown.map((link: any) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
						{group.hidden.length > 0 && (
							<pi-footer-more>
								{/*
								  A <details> so the rest of the group is reachable
								  before the script runs; the element below only adds
								  Escape and click-away. The sheet is taken out of flow,
								  so opening one does not move the columns beside it.
								*/}
								<details class="pi-footer__more">
									<summary aria-label={`Show all ${group.links.length} pages in ${group.label}`}>
										{group.hidden.length} more
									</summary>
									<div class="pi-footer__sheet">
										<h2>{group.label}</h2>
										<ul>
											{group.links.map((link: any) => (
												<li>
													<a href={link.href}>{link.label}</a>
												</li>
											))}
										</ul>
									</div>
								</details>
							</pi-footer-more>
						)}
					</div>
				))
			}
		</nav>
		)}

		<div class="pi-footer__end">
			{isLanding && <span class="pi-footer__mark" aria-hidden="true" />}
			<p class="pi-footer__copy">&copy; {year} Derek McTavish and The Piton Project</p>
		</div>
	</div>
</footer>

<script>
	/*
	 * Click-away and Escape for a footer column's overflow sheet, and only one
	 * sheet open at a time. The <details> itself does the opening and closing,
	 * so with no script the sheet still works — it just stays open until the
	 * summary is clicked again.
	 */
	class PiFooterMore extends HTMLElement {
		connectedCallback() {
			const details = this.querySelector('details');
			if (!details) return;

			details.addEventListener('toggle', () => {
				if (!details.open) return;
				for (const other of document.querySelectorAll('.pi-footer__more[open]')) {
					if (other !== details) (other as HTMLDetailsElement).open = false;
				}
			});

			this.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !details.open) return;
				details.open = false;
				details.querySelector('summary')?.focus();
			});

			document.addEventListener('click', (event) => {
				if (!details.open) return;
				if (event.target instanceof Node && this.contains(event.target)) return;
				details.open = false;
			});
		}
	}

	if (!customElements.get('pi-footer-more')) {
		customElements.define('pi-footer-more', PiFooterMore);
	}
</script>
